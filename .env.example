# Story Sync — local testing environment
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

ANTHROPIC_API_KEY=sk-ant-...
FIGMA_ACCESS_TOKEN=figd_...
GITHUB_TOKEN=ghp_...

# Target repo for created issues and comments (format: org/repo)
REPO_FULL_NAME=spreadcode-dev/queue-tube-mcps

# Issue to use as the source during local testing
# (must exist in the repo — the agent posts a comment on it)
ISSUE_NUMBER=1
ISSUE_TITLE=Queue List Home
ISSUE_BODY=https://www.figma.com/design/YOUR_FILE_KEY/QueueTube?node-id=0-1
