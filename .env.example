# QueueTube MCP Pipelines — local testing environment
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

ANTHROPIC_API_KEY=sk-ant-...
FIGMA_ACCESS_TOKEN=figd_...

# GITHUB_TOKEN — auto-generated by GitHub Actions per workflow run (scoped to THIS repo only).
# For local testing, use a PAT with `repo` scope on spreadcode-dev/queue-tube-mcps.
GITHUB_TOKEN=ghp_...

# GH_PERSONAL_ACCESS_TOKEN — Personal Access Token used by Code Sync to read files from
# AND deliver code to the TARGET app repo (queue-tube-web), which GITHUB_TOKEN cannot access.
# Scopes required (fine-grained, on spreadcode-dev/queue-tube-web):
#   contents:write       — create branches, commit files
#   pull-requests:write  — open and update draft PRs
# Create at: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
GH_PERSONAL_ACCESS_TOKEN=github_pat_...

# Target repo for created issues and comments (format: org/repo)
REPO_FULL_NAME=spreadcode-dev/queue-tube-mcps

# Issue to use as the source during local testing
# (must exist in the repo — the agent posts a comment on it)
ISSUE_NUMBER=1
ISSUE_TITLE=Queue List Home
ISSUE_BODY=https://www.figma.com/design/YOUR_FILE_KEY/QueueTube?node-id=0-1
